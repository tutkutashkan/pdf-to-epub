# Copy this to `.env` on your server and fill in your real values.
# `docker compose -f docker-compose.prod.yml` reads them automatically.

# The domain your site will be served on. You must point this domain's DNS
# A/AAAA record at the server's IP BEFORE starting, or cert issuance fails.
SITE_DOMAIN=pdf2epub.example.com

# Email for Let's Encrypt (renewal + expiry notices). Use a real address.
ADMIN_EMAIL=you@example.com
